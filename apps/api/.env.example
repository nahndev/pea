PORT=3001
DATABASE_URL=postgresql://tomato:tomato@localhost:5435/pea
UPLOAD_DIR=./uploads
# Encrypts stored database connections, at least 32 chars (openssl rand -base64 32)
DATABASE_CONNECTION_KEY=change-me-to-a-random-secret-of-32-chars-or-more
# Set when the app is served over HTTPS
SESSION_COOKIE_SECURE=false
# Seed only: password of the first user `admin`, used when no user exists
ADMIN_PASSWORD=change-me
