generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id       String     @id @default(uuid(7)) @db.Uuid
  name     String     @unique @db.VarChar(255)
  analyses Analysis[]

  @@map("branches")
}

model Analysis {
  id              String           @id @default(uuid(7)) @db.Uuid
  branchId        String           @map("branch_id") @db.Uuid
  mergeRequestIid Int?             @map("merge_request_iid")
  file            String           @db.VarChar(255)
  path            String           @db.VarChar(300)
  createdAt       DateTime         @default(now()) @map("created_at")
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  results         AnalysisResult[]

  @@index([branchId, createdAt(sort: Desc)])
  @@map("analyses")
}

model Rule {
  id          String   @id @default(uuid(7)) @db.Uuid
  type        String   @db.VarChar(50)
  description String
  severity    String   @default("MEDIUM") @db.VarChar(20)
  config      Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  issues      Issue[]

  @@index([type])
  @@map("rules")
}

model Issue {
  id               String          @id @default(uuid(7)) @db.Uuid
  ruleId           String          @map("rule_id") @db.Uuid
  analysisResultId String?         @map("analysis_result_id") @db.Uuid
  description      String?
  status           String          @default("OPEN") @db.VarChar(20)
  severity         String          @default("MEDIUM") @db.VarChar(20)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  rule             Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  analysisResult   AnalysisResult? @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([analysisResultId])
  @@index([status])
  @@index([severity])
  @@map("issues")
}

model AnalysisResult {
  id            String         @id @default(uuid(7)) @db.Uuid
  analysisId    String         @map("analysis_id") @db.Uuid
  status        String         @default("RUNNING") @db.VarChar(20)
  issueCount    Int            @default(0) @map("issue_count")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  analysis      Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  issues        Issue[]
  metricResults MetricResult[]

  @@index([analysisId, createdAt(sort: Desc)])
  @@map("analysis_results")
}

model Metric {
  id          String            @id @default(uuid(7)) @db.Uuid
  type        String            @db.VarChar(50)
  unit        String            @default("MILLISECOND") @db.VarChar(20)
  description String
  isActive    Boolean           @default(true) @map("is_active")
  config      Json              @default("{}") @db.JsonB
  results     MetricResult[]
  conditions  MetricCondition[]

  @@index([type])
  @@map("metrics")
}

model MetricResult {
  id               String             @id @default(uuid(7)) @db.Uuid
  metricId         String             @map("metric_id") @db.Uuid
  analysisResultId String             @map("analysis_result_id") @db.Uuid
  subject          String             @default("") @db.VarChar(255)
  value            Float
  createdAt        DateTime           @default(now()) @map("created_at")
  metric           Metric             @relation(fields: [metricId], references: [id], onDelete: Cascade)
  analysisResult   AnalysisResult     @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  evaluations      MetricEvaluation[]

  @@unique([analysisResultId, metricId, subject])
  @@index([metricId, createdAt(sort: Desc)])
  @@map("metric_results")
}

model QualityGate {
  id          String            @id @default(uuid(7)) @db.Uuid
  name        String            @unique @db.VarChar(100)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  conditions  MetricCondition[]

  @@map("quality_gates")
}

model MetricCondition {
  id            String             @id @default(uuid(7)) @db.Uuid
  qualityGateId String             @map("quality_gate_id") @db.Uuid
  metricId      String             @map("metric_id") @db.Uuid
  operator      String             @db.VarChar(10)
  threshold     Float
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  qualityGate   QualityGate        @relation(fields: [qualityGateId], references: [id], onDelete: Cascade)
  metric        Metric             @relation(fields: [metricId], references: [id], onDelete: Cascade)
  evaluations   MetricEvaluation[]

  @@unique([qualityGateId, metricId])
  @@index([qualityGateId])
  @@index([metricId])
  @@map("metric_conditions")
}

model MetricEvaluation {
  id                String          @id @default(uuid(7)) @db.Uuid
  metricResultId    String          @map("metric_result_id") @db.Uuid
  metricConditionId String          @map("metric_condition_id") @db.Uuid
  status            String          @db.VarChar(20)
  operator          String          @db.VarChar(10)
  threshold         Float
  createdAt         DateTime        @default(now()) @map("created_at")
  metricResult      MetricResult    @relation(fields: [metricResultId], references: [id], onDelete: Cascade)
  metricCondition   MetricCondition @relation(fields: [metricConditionId], references: [id], onDelete: Cascade)

  @@unique([metricResultId, metricConditionId])
  @@index([metricConditionId])
  @@map("metric_evaluations")
}
