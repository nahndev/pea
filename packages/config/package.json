{
  "name": "@tomato/config",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/config": "4.0.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.8",
    "@tomato/tsconfig": "workspace:*",
    "@types/node": "20.19.43",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
